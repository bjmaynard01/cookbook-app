# Dev values — placeholders only. Real values live in .env (git-ignored).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cookbook
DB_USER=cookbook
DB_PASSWORD=devpassword
DB_ROOT_PASSWORD=devrootpassword
SECRET_KEY=devsecretkey
# Preferred: generate a real key once and keep it in a file (never in .env):
#   cookbook init-secret                # writes ./secret.key (git-ignored, best-effort 0600)
# Then set SECRET_KEY_FILE=./secret.key (_FILE wins over SECRET_KEY).
# Rotation: re-run with --overwrite, then restart the app.

# How long a login stays valid before it must be done again (default: 12).
SESSION_TTL_HOURS=12

# --- Bootstrap (first admin only) ---
# FIRST_ADMIN_PASSWORD_FILE: create the owner from a file. Use this to avoid
# any plain password landing in .env or in shell history / the process list.
# FIRST_ADMIN_PASSWORD=... works but is for quick local dev only — its value is
# visible to `ps`, shell history, and anyone who can read .env. Never use it
# with a real password.
APP_BIND_PORT=8000

# Host directory for persistent MariaDB and media bind mounts.
# Linux default. On Windows, use a local path outside synced folders, e.g.
# C:/Users/<you>/AppData/Local/cookbook-app
COOKBOOK_DATA_DIR=/mnt/container

# --- Trusted proxy / cookie security (auth) ---
# Comma-separated CIDRs of *actual trusted reverse proxies* (the direct TCP
# peers that may supply X-Forwarded-For / X-Forwarded-Proto). Leave empty in
# plain dev; the app owns header interpretation (uvicorn runs with
# --no-proxy-headers). An empty value means no peer is trusted.
TRUSTED_PROXY_CIDRS=

# Optional. Blank/unset = follow the effective request scheme (https ->
# Secure, http -> no Secure). Explicit true/false overrides that decision;
# setting it to false on HTTPS is a deliberate security weakening.
COOKIE_SECURE=
